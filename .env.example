# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_SCHEMA=faith_harbor
SUPABASE_FEED_MEDIA_BUCKET=faith-harbor-feed-media
SUPABASE_PROFILE_AVATARS_BUCKET=faith-harbor-profile-avatars

# ---- Scheduled notifications ----
# Vercel sends this value as `Authorization: Bearer ...` to cron routes.
CRON_SECRET=
# Required only when Enhanced Push Security is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ---- Website ----
NEXT_PUBLIC_SITE_URL=https://vella.one
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6790616297
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=io.vella.app
# Availability controls what the public website advertises. Keep iOS disabled
# until the App Store product page is publicly reachable.
NEXT_PUBLIC_IOS_STORE_AVAILABLE=false
NEXT_PUBLIC_ANDROID_STORE_AVAILABLE=true

# ---- OpenAI (server-side only — never expose to the client) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ---- Stripe ----
# Start in TEST mode (sk_test_...). Switch to sk_live_... only at launch.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe CLI (`stripe listen`) or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs produced by `yarn stripe:setup` — see docs/STRIPE_SETUP.md
STRIPE_PRICE_PREMIUM_INDIVIDUAL_MONTHLY=
STRIPE_PRICE_PREMIUM_INDIVIDUAL_ANNUAL=
STRIPE_PRICE_PREMIUM_FAMILY_MONTHLY=
STRIPE_PRICE_PREMIUM_FAMILY_ANNUAL=

# ---- Native In-App Purchase (primary mobile rail) ----
# Apple: App Store Connect → your app → App-Specific Shared Secret.
APPLE_SHARED_SECRET=
# Public app identity used to verify App Store Server Notifications V2.
APPLE_BUNDLE_ID=io.vella.app
APPLE_APP_ID=6790616297
# Apple Ads account organization ID. AdServices results from any other org are
# rejected and remain pending/unattributed rather than entering source truth.
APPLE_ADS_ORG_ID=
# Android: your app's package name.
ANDROID_PACKAGE_NAME=io.vella.app
# Android: full JSON of a Play Console service account with Android Publisher
# access, on ONE line (or base64 — adjust the loader if you prefer base64).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Authenticated Pub/Sub push settings. Audience must exactly equal the audience
# configured on the push subscription (normally the canonical webhook URL).
GOOGLE_PUBSUB_AUDIENCE=https://vella.one/api/v1/webhooks/google
# Email of the user-managed service account selected under the Pub/Sub push
# subscription's "Enable authentication" setting. This can be distinct from
# the Android Publisher service account whose JSON key is stored above.
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# ---- Internal moderation operations ----
# Generate at least 32 random bytes; send only as x-vella-operator-key.
VELLA_OPERATOR_API_KEY=
